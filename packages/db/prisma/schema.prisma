generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum SystemRoleKey {
  OWNER
  ADMIN
  SECURITY_LEAD
  MEMBER
  VIEWER
  AUDITOR
  GUEST
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
  PLATFORM_ADMIN
}

/// A session that has passed the password check but not yet the MFA check is
/// PENDING_MFA: it exists, it is revocable, and it can do nothing but complete
/// MFA (security/authentication.md §5). Modelling it as a Session status rather
/// than a separate credential is ADR-0018 — it reuses revocation and makes
/// "rotate on privilege change" literal rather than analogous.
enum SessionStatus {
  PENDING_MFA
  ACTIVE
}

/// TOTP is what Phase 2 implements. WEBAUTHN is declared here from the start
/// because authentication.md §5 requires that adding it be an insert into this
/// table, not a migration of the authentication model.
enum MfaFactorType {
  TOTP
  WEBAUTHN
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id
  slug      String             @unique
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  /// Organisations may require MFA of their members. Enforced server-side on
  /// every request, not only at login (security/authentication.md §5): a member
  /// without a confirmed factor is forced into enrolment before any other
  /// action. Read by the Task 12 guards; nothing before that reads it.
  requireMfa Boolean @default(false)

  /// The Phase 11 SSO hook. security/authentication.md §8 requires this exist
  /// from Phase 2 with `IdentityProviderLink`, and says why: SAML/OIDC land in
  /// Phase 11, but re-modelling identity later is the single most expensive
  /// migration an enterprise SaaS can face, and an optional column costs
  /// nothing now. When set, an organisation only admits members whose verified
  /// email is in that domain. NOTHING IN PHASE 2 READS THIS — it is not dead,
  /// it is early.
  enforcedEmailDomain String?

  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Global identity. A User is one human with one login and many organisations;
// Membership is what makes them a participant in a tenant. This is why
// authorization is always (user, organization, permission), never
// (user, permission). See architecture/database.md §2.
// ---------------------------------------------------------------------------

model User {
  id              String     @id
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  name            String?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  /// Brute-force state, per account, per security/authentication.md §7. This is
  /// ADDITIONAL to the Redis rate limiter, not a substitute: the limiter bounds
  /// the RATE of attempts and forgets quickly; `failedLoginCount` bounds the
  /// TOTAL and survives a restart of Redis. An attacker who paces themselves
  /// under the limiter still trips this.
  ///
  /// `lockedUntil` is the temporary, automatic lock and clears itself.
  /// `status = LOCKED` is the separate administrative one and does not. Do not
  /// conflate them: reading only `status` misses every brute-force lock.
  lastLoginAt      DateTime? @db.Timestamptz(6)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)

  credential  Credential?
  sessions    Session[]
  memberships Membership[]
  invitesSent Invitation[] @relation("InvitationInvitedBy")

  // Every relation below is onDelete: Cascade, unlike Membership.userId's
  // Restrict. The distinction is whether the cascade can cross a tenant
  // boundary — read the Membership.userId comment for the case where it can.
  // These four are single-user-owned and carry no organizationId, so there is
  // no second tenant for a cascade to reach.
  //
  // BUT BE PRECISE ABOUT WHEN THEY FIRE. Membership.userId is Restrict and
  // Invitation.invitedByUserId is Restrict, so a DELETE on a User who has ever
  // joined an organisation or sent an invitation RAISES a foreign-key
  // violation — which is every real user of this product. These cascades only
  // fire for a registered account that never joined anything: an abandoned
  // signup. They are a correctness backstop for that narrow case, not an
  // account-deletion mechanism; for everyone else the DELETE fails and the
  // authentication material is left behind by a failed statement. Real account
  // deletion must remove memberships and invitations first, through the
  // tenant-scoped path, and it needs a design that does not exist yet.
  mfaFactors            MfaFactor[]
  recoveryCodes         RecoveryCode[]
  verificationTokens    VerificationToken[]
  identityProviderLinks IdentityProviderLink[]
}

model Credential {
  id           String   @id
  userId       String   @unique
  passwordHash String
  algorithm    String   @default("argon2id")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                   String  @id
  userId               String
  tokenHash            String  @unique
  // The organisation the session is currently acting in. Nullable because a
  // user may be signed in before choosing one. A Session is user-owned, not
  // tenant-owned, so it is deliberately NOT in the tenant resource registry.
  activeOrganizationId String?
  ip                   String?
  userAgent            String?

  /// TWO LIFETIMES, TWO COLUMNS. security/authentication.md §3 gives a session
  /// an absolute lifetime (7 days, 30 with "remember me") AND an idle timeout
  /// (24h, renewed past the halfway mark). These are different clocks: the idle
  /// one moves forward every time the session is used, the absolute one never
  /// does. Phase 1's single `expiresAt` could only be one of them, which is how
  /// the other silently stops being enforced — renew `expiresAt` on activity
  /// and the absolute cap is gone; don't, and there is no idle timeout. Renamed
  /// to `idleExpiresAt` so neither name can be read as the other.
  idleExpiresAt     DateTime @db.Timestamptz(6)
  absoluteExpiresAt DateTime @db.Timestamptz(6)

  /// Deliberately has no @default. A session's privilege level must be stated
  /// by whoever creates it: defaulting to ACTIVE would make "forgot to set the
  /// status" mint a fully privileged session, which is the wrong direction to
  /// fail in.
  status SessionStatus

  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(6)
  mfaCompletedAt DateTime? @db.Timestamptz(6)
  rememberMe     Boolean   @default(false)
  /// The session this one replaced, per §3's "rotated on every privilege
  /// change" — login, MFA completion, password change, role change. Deliberately
  /// a plain column and NOT a self-referencing foreign key: the predecessor row
  /// is routinely revoked and later pruned, and a FK would either block that
  /// prune or null out the breadcrumb exactly when a rotation chain is being
  /// reconstructed during an incident.
  rotatedFromId  String?
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Not a rename of Phase 1's @@index([userId, expiresAt]) — that index served
  // no query Phase 2 actually issues. The token lookup on the hot path is
  // covered by tokenHash's unique index. What is left is:
  //   1. list / revoke a user's sessions for /settings/security — userId first,
  //      most recently used first;
  //   2. sweep expired sessions across ALL users — which the old composite
  //      could not serve at all, because userId led it.
  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([absoluteExpiresAt])
}

/// A second factor belonging to one User. MULTI-ROW AND TYPED FROM THE START:
/// authentication.md §5 requires that adding WebAuthn be an insert here rather
/// than a migration of the authentication model, which it would be if this were
/// a `totpSecret` column on User.
///
/// `secretEncrypted` is ENCRYPTED, not hashed — the only field in this phase
/// that is. A TOTP secret must be recoverable to recompute the expected code,
/// so a one-way hash cannot work here. It is encrypted with the application key
/// and never logged, never returned by the API, and shown once at enrolment.
///
/// A factor with `confirmedAt = NULL` has never proven a code and IS NOT
/// ENROLLED. §5: the secret is "only persisted as enabled after the user proves
/// one correct code". Any check for "does this user have MFA" must test
/// `confirmedAt IS NOT NULL`; counting rows is the wrong query and would let an
/// abandoned half-enrolment satisfy an organisation's requireMfa.
model MfaFactor {
  id               String        @id
  userId           String
  type             MfaFactorType
  secretEncrypted  String
  /// WHICH KEY ENCRYPTED `secretEncrypted`. Nullable, and **Phase 2 Task 11
  /// writes it on every row it creates** — the value is `1`, stated explicitly
  /// rather than left to the default meaning, because a column nothing writes
  /// is dead weight rather than cheap insurance (carry-forward ruling 8).
  ///
  /// NULL therefore describes no row in any database. It is still read, and it
  /// still means "the application key that was current when this row was
  /// written", which is version 1 — a rotation story that cannot read its own
  /// oldest rows is not a rotation story. `mfa-secret.ts` also carries the
  /// version inside `secretEncrypted`'s envelope and **refuses a row whose
  /// column and envelope disagree**: that state means a re-encryption wrote one
  /// and not the other, and guessing which is authoritative decrypts with the
  /// wrong key and returns bytes that look like a secret.
  ///
  /// It exists for the same reason `IdentityProviderLink` does, one level down:
  /// a column costs nothing now, and retrofitting one is expensive precisely
  /// when it is needed. Without it, rotating the application key means
  /// re-encrypting every row in a single migration with no way to tell, part way
  /// through or after a failure, which rows are on the old key and which on the
  /// new — the rotation becomes all-or-nothing on a table holding the secrets
  /// that gate every MFA challenge. With it, rotation is incremental and
  /// resumable: read the version, decrypt with that key, re-encrypt with the
  /// current one, bump the version.
  ///
  /// Named for the field it describes rather than the row: an MfaFactor of type
  /// WEBAUTHN holds no encrypted secret at all, and this column has nothing to
  /// say about it.
  secretKeyVersion Int?
  confirmedAt      DateTime?     @db.Timestamptz(6)
  label            String?
  lastUsedAt       DateTime?     @db.Timestamptz(6)

  /// THE REPLAY DEFENCE. The RFC 6238 step counter of the most recently
  /// accepted code, and any code whose step is <= this is refused.
  ///
  /// Without it the ±1 drift window is an attack surface rather than a
  /// tolerance: a code stays computable for ~90 seconds, so an attacker who
  /// observes one — over a shoulder, through a phished form, from a proxy —
  /// can present it again inside that window and it verifies. The drift window
  /// does not defend against this and nothing else in the TOTP design does.
  /// Storing the last accepted step is the standard answer and
  /// `security/authentication.md` §5 names it.
  ///
  /// `Int`, not `BigInt`. At a 30-second step the counter reaches 2^31-1 in the
  /// year 4011, so int4 is not a bound anyone will meet; `BigInt` would map to
  /// a JavaScript `bigint`, which cannot be compared with a `number` without an
  /// explicit conversion at every site — a footgun in a comparison that IS a
  /// security control. Nullable because a factor that has never accepted a code
  /// has no floor, and 0 would be a real step (1 January 1970) rather than an
  /// absence.
  ///
  /// **The check and the write must be one statement.** Reading this column and
  /// then updating it lets two concurrent requests carrying the same code both
  /// pass; `mfa-verification.service.ts` writes it with a conditional
  /// `updateMany` whose predicate is this column, so Postgres arbitrates and
  /// exactly one request sees `count: 1`.
  lastAcceptedStep Int?
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One factor per type per user for now. WebAuthn expects several
  // authenticators per user, so this widens to include a credential
  // identifier when that lands — additively, which is the point of the table.
  @@unique([userId, type])
}

/// Ten single-use codes per user, issued at MFA enrolment and shown once
/// (authentication.md §5). Argon2id-hashed rather than SHA-256 like the token
/// tables below, because a recovery code is human-typed and therefore low
/// entropy relative to a 256-bit random token — it needs the work factor.
///
/// `usedAt` rather than deletion: a spent code must stay visible so it cannot
/// be silently reissued, and so the user can be shown how many remain.
/// Regeneration deletes the whole set and issues ten new ones.
model RecoveryCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

/// Email verification and password reset tokens. ONE TABLE, TWO PURPOSES,
/// because authentication.md §6 gives all of these the same discipline —
/// 256-bit random, hashed at rest, single-use, expiring, invalidated by use or
/// by a newer token — and one table means one implementation of that discipline
/// to get right rather than two that drift.
///
/// `Invitation` is deliberately NOT folded in here despite sharing the
/// discipline: it is tenant-owned (it carries organizationId, lives under RLS,
/// and is in TENANT_OWNED_MODELS), and these two are not. Merging them would
/// put tenant-owned rows in a table with no tenant column.
///
/// Only `tokenHash` is stored, so the database cannot mint a valid token.
model VerificationToken {
  id         String              @id
  userId     String
  purpose    VerificationPurpose
  tokenHash  String              @unique
  expiresAt  DateTime            @db.Timestamptz(6)
  consumedAt DateTime?           @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Invalidating a user's older tokens of the same purpose when a new one is
  // issued is a lookup on exactly this pair.
  //
  // A PARTIAL UNIQUE INDEX ON THE SAME PAIR ALSO EXISTS AND IS NOT VISIBLE HERE.
  // `VerificationToken_userId_purpose_live_key` — UNIQUE (userId, purpose) WHERE
  // "consumedAt" IS NULL — was added by hand in
  // `20260828051500_verification_token_partial_unique`, because Prisma can
  // neither express nor detect a partial index (carry-forward ruling 4). It is
  // what makes §6's "one live token per user per purpose" the database's
  // invariant rather than `TokenService.issue`'s. DO NOT "restore" a plain
  // `@@unique([userId, purpose])` here: that would forbid a user from ever
  // holding two tokens of the same purpose across their whole history, consumed
  // ones included.
  @@index([userId, purpose])
}

/// DO NOT DELETE THIS AS DEAD CODE. NOTHING IN PHASE 2 READS IT, AND THAT IS
/// EXPECTED.
///
/// security/authentication.md §8 and ADR-0005 both require this table exist
/// from Phase 2 even though SAML 2.0 and OIDC do not land until Phase 11. The
/// reason is stated in §8: designing these tables now costs nothing, and
/// re-modelling identity later is the single most expensive migration an
/// enterprise SaaS can face. A table with no rows is cheap; retrofitting
/// external identity onto a live user base is not.
///
/// `providerId` names the configured provider, `externalId` is the subject as
/// that provider knows it. Both uniques matter and neither implies the other:
/// (providerId, externalId) stops two local users claiming one external
/// identity; (userId, providerId) stops one local user holding two identities
/// at the same provider.
model IdentityProviderLink {
  id         String   @id
  userId     String
  providerId String
  externalId String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@unique([userId, providerId])
}

// ---------------------------------------------------------------------------
// Roles are system-wide reference data in Phase 1. Custom per-organisation
// roles arrive in Phase 11 and will add a nullable organizationId here.
// ---------------------------------------------------------------------------

model Role {
  id          String        @id
  key         SystemRoleKey @unique
  name        String
  description String
  isSystem    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]
}

model Permission {
  id          String   @id
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Tenant-owned. Every one of these carries organizationId DIRECTLY, with a
// leading index, and must be registered in src/tenant-resources.ts.
// ---------------------------------------------------------------------------

model Membership {
  id             String           @id
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a User -> Membership cascade runs as referential
  // integrity, below both RLS and the tenant-scoped client — deleting a user
  // who belongs to several organisations would silently destroy every other
  // tenant's Membership row for them in one statement, invisible to either
  // isolation layer. Verified live (review round 3): over sentinel_app,
  // inside withTenantTransaction(orgA), deleting a user shared with orgB
  // destroyed orgB's membership too. Restrict means deleting a User fails
  // while any Membership still references them — self-serve account
  // deletion (Phase 2) must remove the user's memberships, one organisation
  // at a time through the normal tenant-scoped path, before the User row
  // itself can go. DELETE on User is deliberately still granted to
  // sentinel_app, so that path stays open for whoever builds it.
  //
  // CORRECTED IN PHASE 2, TASK 1. This comment previously ended "account
  // deletion is a legitimate Phase 2 flow, not a platform-admin-only one".
  // Checked against the Phase 2 plan when this file was next edited: none of
  // its eighteen tasks is account deletion, and none is planned. The Restrict
  // reasoning above is unaffected and stands — what was wrong was only the
  // claim that a flow exists to satisfy it. It does not. Account deletion needs
  // its own design: with Restrict here and on Invitation.invitedByUserId, a
  // plain DELETE on a User who has ever joined an organisation or sent an
  // invitation raises a foreign-key violation, so deletion has to unwind
  // memberships and invitations first, one organisation at a time, through the
  // tenant-scoped path. Recorded rather than quietly rewritten, because the
  // original sentence was written in Phase 1 and believed until it was
  // checked.
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // UNIQUENESS LIVES IN SQL, NOT HERE — deliberately, and there is no
  // `@@unique([organizationId, userId])` line below by design.
  //
  // The rule is "at most one LIVE membership per (organizationId, userId)".
  // Membership soft-deletes via `deletedAt`, so a full unique index counts
  // removed rows too and re-inviting a removed member fails with a duplicate
  // key. Prisma's schema language cannot express `WHERE "deletedAt" IS NULL`,
  // so the constraint is a partial unique index created by hand in
  // `migrations/20260824153519_membership_partial_unique/migration.sql`:
  // `Membership_organizationId_userId_active_key`.
  //
  // A SECOND CONSTRAINT LIVES IN SQL TOO, for the same reason, and in the SAME
  // migration: the CHECK `("deletedAt" IS NULL) = (status <> 'REMOVED')`, named
  // `Membership_status_deletedAt_agree_check`. The two ship together because
  // they are two halves of one invariant — a database stopped between them
  // would hold the broken state described next. The partial index keys on
  // `deletedAt` while `status` is an independent column, so without it a row
  // could be `ACTIVE` and soft-deleted at once — outside the index predicate,
  // therefore not occupying the unique slot, therefore admitting a second live
  // membership for the same pair and two roles for one user. The mirror case,
  // `REMOVED` with a NULL `deletedAt`, holds the slot while claiming to be
  // removed. The CHECK makes removal one fact instead of two. It is a
  // biconditional across all three statuses: `INVITED` requires
  // `deletedAt IS NULL`, because a pending invitation is a live row and should
  // hold the slot.
  //
  // WHAT PRISMA ACTUALLY DOES ABOUT EITHER OF THEM, measured rather than
  // assumed. Nothing. Its engine can represent neither a partial index nor a
  // CHECK constraint, so it does not see them in either direction — it will not
  // create them and it will not drop them. The Phase 2 plan predicted the
  // opposite for the index (drift reported, the full `@@unique` re-offered);
  // generating the next migration emitted no Membership statement at all.
  //
  // To reproduce: run `prisma migrate diff --from-url <db> --to-schema-datamodel
  // prisma/schema.prisma --script` and COUNT THE STATEMENTS MENTIONING
  // "Membership". It is zero. Measured at zero against a database in sync with
  // this file, where the whole diff came back empty, and zero again against one
  // two migrations behind, where the diff was 117 lines of unrelated DDL. The
  // count is the durable claim; "the diff is empty" is not, because that
  // depended on the database matching this file in every other respect.
  //
  // The two real ways to lose this index both need a human:
  //   1. `prisma db push`, which builds from THIS FILE alone and never replays
  //      the migration history — the index would simply not exist. Use
  //      `migrate dev` / `migrate deploy` / `migrate reset`, which all replay.
  //   2. Someone seeing no `@@unique` here, assuming it was forgotten, and
  //      adding `@@unique([organizationId, userId])` back. That creates a FULL
  //      unique index alongside the partial one and re-breaks re-invite. That
  //      is what this comment exists to prevent — the line is missing on
  //      purpose.
  // Either way `src/membership-soft-delete.integration.spec.ts` goes red on
  // re-invite, which is the signal to come back and read this.
  @@index([organizationId, status])
  @@index([userId])
}

model Invitation {
  id              String    @id
  organizationId  String
  email           String
  roleId          String
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime  @db.Timestamptz(6)
  acceptedAt      DateTime? @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, email])
  @@index([organizationId, createdAt(sort: Desc)])
}

/// Append-only. The row_level_security migration revokes UPDATE and DELETE on
/// this table from `sentinel_app` and adds a BEFORE UPDATE/DELETE trigger that
/// raises, per security/audit.md §2. Full audit architecture (event taxonomy,
/// redaction, retention, query API) remains Phase 3 — this table currently
/// carries only the tamper-resistance controls, not the rest of that design.
///
/// The relation below is deliberately `onDelete: Restrict`, not `Cascade`.
/// `Cascade` would let a foreign-key cascade silently destroy the audit trail
/// the moment an organisation row is deleted — outside RLS and outside the
/// append-only trigger, since RI cascades run at a lower level than either.
/// `Restrict` makes organisation deletion fail while audit events still exist
/// for it, forcing an explicit, auditable purge path rather than an implicit
/// one. `sentinel_app` cannot delete `Organization` rows at all (see the
/// row_level_security migration), so in practice this only binds a future
/// platform-admin deletion path (Phase 11) — but the constraint is what makes
/// that true by construction rather than by convention.
model AuditEvent {
  id             String    @id
  organizationId String
  actorType      ActorType
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json      @default("{}")
  ip             String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
}

/// Security-relevant actions that have **no organisation** (ADR-0019).
///
/// A user registering and a user verifying their email address both happen
/// before the account belongs to anything, and `AuditEvent` cannot hold them:
/// its `organizationId` is NOT NULL with a `Restrict` foreign key, and it
/// carries the row-level-security policy
/// `"organizationId" = current_setting('app.organization_id', true)` — measured
/// on 2026-08-28 to REFUSE a NULL-organisation insert, so relaxing the column
/// alone would not have made the write work. ADR-0019 records the four
/// constraints and the three rejected alternatives.
///
/// Same fields as `AuditEvent` minus `organizationId`, and the same tamper
/// resistance: `UPDATE` and `DELETE` revoked from `sentinel_app` plus the
/// append-only trigger, reusing the `audit_event_is_append_only()` function the
/// Phase 1 row-level-security migration already created rather than writing a
/// second one.
///
/// The routing rule is the presence of an organisation, not the kind of action:
/// `EMAIL_VERIFIED` for a user who belongs to no organisation is a platform
/// event, and the same action for a member acting inside one is a tenant event.
///
/// `actorId` carries no foreign key, exactly as `AuditEvent.actorId` does not:
/// an audit row must outlive the row it names.
model PlatformAuditEvent {
  id           String    @id
  actorType    ActorType
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json      @default("{}")
  ip           String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
}
