# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# Build output
# next-env.d.ts is generated by Next and rewritten depending on which command
# ran last (`next dev` points it at .next/dev/types, `next build` at
# .next/types), so tracking it means it flips in git status every time a
# developer alternates the two. Ignored, as current create-next-app does.
# Verified safe for a cold CI checkout: with apps/web/.next absent entirely,
# tsc --noEmit still exits 0.
apps/web/next-env.d.ts
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# `pnpm check:openapi` regenerates the OpenAPI document here rather than over
# the committed apps/api/openapi.json, so the check never destroys the evidence
# it is comparing against. Removed in a `finally`; ignored so that a killed run
# still cannot dirty the working tree.
apps/api/.openapi-check.json

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Prisma
packages/db/prisma/*.db
packages/db/prisma/*.db-journal
packages/db/generated/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Editor and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Local scan artifacts and evidence — must never reach the repository
/tmp/
/scratch/
evidence-local/
scan-output/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Subagent-driven development scratch (ledger, briefs, review packages)
.superpowers/
