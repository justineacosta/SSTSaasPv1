# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# Build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Prisma
packages/db/prisma/*.db
packages/db/prisma/*.db-journal

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Editor and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Local scan artifacts and evidence — must never reach the repository
/tmp/
/scratch/
evidence-local/
scan-output/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
