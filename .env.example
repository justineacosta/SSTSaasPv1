# ---------------------------------------------------------------------------
# Sentinel — local development environment.
# Copy to .env. These placeholders are safe for LOCAL USE ONLY.
# Never copy a staging or production secret into this file.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
APP_ENV=development                  # development | test | staging | production
LOG_LEVEL=debug                      # debug | info | warn | error | fatal

# Web -----------------------------------------------------------------------
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
# The port the Playwright suite starts its OWN server on. Deliberately not
# WEB_PORT: playwright.config.ts reuses an already-listening server locally,
# so a shared port would let a stray `pnpm dev` be what the E2E suite tests.
E2E_PORT=3100

# API -----------------------------------------------------------------------
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Database ------------------------------------------------------------------
# DATABASE_URL is the least-privileged application role. It is NOT a superuser
# and does NOT have BYPASSRLS, which is what makes row-level security a real
# second layer rather than decoration.
DATABASE_URL=postgresql://sentinel_app:sentinel_app_local@localhost:5432/sentinel?schema=public
# DIRECT_DATABASE_URL owns the schema and is used only by `prisma migrate`.
DIRECT_DATABASE_URL=postgresql://sentinel:sentinel_local@localhost:5432/sentinel?schema=public

# Redis ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Object storage (MinIO locally, R2/S3 in production) -----------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=sentinel_local
STORAGE_SECRET_ACCESS_KEY=sentinel_local_secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_EVIDENCE=evidence
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_EXPORTS=exports

# Mail (Mailpit locally — nothing leaves the machine) -----------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Sentinel <no-reply@sentinel.local>"
# Implicit TLS from the first byte (port 465's convention). Left false here and
# in production on 587, where nodemailer upgrades the plaintext connection with
# STARTTLS whenever the relay advertises it. Mailpit on 1025 speaks plaintext.
# MAIL_SECURE=false
# Relay credentials. Commented out rather than left blank: the schema refuses an
# empty value, and it refuses one of the pair without the other — a username
# with no password makes nodemailer send unauthenticated instead of failing
# (ADR-0016, packages/config/src/env.ts). Set BOTH or NEITHER.
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Passwords -----------------------------------------------------------------
# Argon2id cost, held in configuration so it can be raised without a code
# change (ADR-0014). These are security/authentication.md §2's starting point,
# NOT tuned numbers — §2 says to tune them on production hardware to ~250ms.
# Raising them takes effect on existing accounts at the next successful login.
# Argon2 also requires MEMORY_KIB >= 8 * PARALLELISM; the config layer rejects a
# pair that violates it and names both variables, rather than letting the native
# module throw at boot.
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_PARALLELISM=4

# HIBP k-anonymity breach check (ADR-0015). Off by default: only the first five
# hex characters of the password's SHA-1 ever leave the process, but no test
# suite should depend on a third party being reachable. The check fails open —
# on timeout, error, or a non-200 the password is allowed and a warn is logged.
PASSWORD_BREACH_CHECK_ENABLED=false
PASSWORD_BREACH_CHECK_TIMEOUT_MS=2000
PASSWORD_BREACH_CHECK_RANGE_URL=https://api.pwnedpasswords.com/range

# Single-use secret tokens ---------------------------------------------------
# security/authentication.md §6 gives email verification, password reset and
# invitation one discipline, and these three TTLs. All in SECONDS, deliberately
# — one unit means one multiplication per purpose, and a mixed _HOURS/_DAYS set
# is how a `60` gets read as the wrong thing. Held in configuration so a TTL can
# be shortened during an incident without a deploy. Minimum 1; zero or less
# would issue a token that has already expired, and the config layer refuses it
# at boot naming the variable.
TOKEN_TTL_EMAIL_VERIFICATION_SECONDS=86400   # 24 hours
TOKEN_TTL_PASSWORD_RESET_SECONDS=3600        # 1 hour
TOKEN_TTL_INVITATION_SECONDS=604800          # 7 days

# Sessions ------------------------------------------------------------------
# security/authentication.md §3. All in SECONDS, like the token TTLs above.
# The first three are §3's own numbers. The last two are choices this
# repository made, because §5 calls the pending-MFA session only "short-lived"
# and ADR-0005 calls the cache TTL only "short" — neither gives a figure.
# The config layer refuses a remember-me lifetime shorter than the ordinary
# one, and a pending-MFA lifetime longer than a full session.
SESSION_ABSOLUTE_LIFETIME_SECONDS=604800      # 7 days
SESSION_REMEMBER_ME_LIFETIME_SECONDS=2592000  # 30 days
SESSION_IDLE_TIMEOUT_SECONDS=86400            # 24 hours
SESSION_PENDING_MFA_LIFETIME_SECONDS=600      # 10 minutes
# How long a resolved session may be served from Redis. This is the bound on
# one residual: a revocation that cannot reach Redis revokes the row but cannot
# poison the cache entry, so a surviving entry serves a revoked session until it
# expires. Shorter narrows that window and costs more Postgres reads.
SESSION_CACHE_TTL_SECONDS=60

# MFA -----------------------------------------------------------------------
# The AES-256-GCM key that encrypts MfaFactor.secretEncrypted — the only field
# in Phase 2 that is encrypted rather than hashed, because verifying a TOTP code
# means recomputing it. Base64 for exactly 32 bytes; the config layer refuses
# any other decoded length AT BOOT, naming the variable, rather than letting
# createCipheriv throw "Invalid key length" at the first user who enrols.
#
# This is the ONE variable with no default. A default would be a shipped
# encryption key. The value below is a placeholder of repeated bytes — the right
# length, obviously not a secret, and low-entropy on purpose so `pnpm
# check:secrets` does not flag a committed file. GENERATE A REAL ONE:
#   openssl rand -base64 32
# Rotating it is incremental rather than all-or-nothing: MfaFactor.secretKeyVersion
# records which key encrypted each row (schema.prisma).
MFA_SECRET_ENCRYPTION_KEY=KioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKio=
