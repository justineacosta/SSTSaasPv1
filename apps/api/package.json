{
  "name": "@sentinel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- node scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "openapi:generate": "tsc -p tsconfig.build.json && dotenv -e ../../.env -- node dist/openapi/cli.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@node-rs/argon2": "^2.1.0",
    "@sentinel/config": "workspace:*",
    "@sentinel/contracts": "workspace:*",
    "@sentinel/db": "workspace:*",
    "@sentinel/observability": "workspace:*",
    "@sentinel/storage": "workspace:*",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
