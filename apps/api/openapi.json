{
  "openapi": "3.0.3",
  "info": {
    "title": "Sentinel API",
    "version": "1",
    "description": "Multi-tenant security testing, penetration-test management, and vulnerability management."
  },
  "paths": {
    "/api/v1/auth/change-password": {
      "post": {
        "operationId": "AuthController_changePassword",
        "tags": [
          "Auth"
        ],
        "summary": "Change your password.",
        "description": "Requires the current password as well as a session: changing a password from a stolen session without proving the old one is an account-takeover step, not a settings edit. Every other session is signed out and this one is rotated, so `Set-Cookie` carries a new `__Host-session` and `__Host-csrf`. Requires `X-CSRF-Token`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  }
                },
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The password is changed. Every other session is revoked and this one is rotated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "PASSWORD_CHANGED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The current password is wrong (`INVALID_CREDENTIALS`), or there is no usable session (`UNAUTHENTICATED` or `SESSION_EXPIRED`)."
          },
          "403": {
            "description": "Missing or mismatched `X-CSRF-Token` (`CSRF_TOKEN_INVALID`)."
          },
          "422": {
            "description": "The new password appears in a public breach corpus (`PASSWORD_BREACHED`). This check is disabled by default and fails open, so its absence is not a claim about the password."
          },
          "429": {
            "description": "Rate limited: 10 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "authenticated"
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "operationId": "AuthController_forgotPassword",
        "tags": [
          "Auth"
        ],
        "summary": "Ask for a password-reset link.",
        "description": "Sends a single-use reset link. The response is identical whether or not the address has an account, and whether or not that account has confirmed its address — nothing about which case occurred reaches the caller. An account that has never confirmed its address does receive a link; an administratively locked or disabled one does not.",
        "requestBody": {
          "description": "The address is lower-cased and trimmed before use. The schema is strict.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  }
                },
                "required": [
                  "email"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. Whether anything was sent is deliberately not reported.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "RESET_REQUESTED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The request was refused as cross-site (`CSRF_TOKEN_INVALID`)."
          },
          "429": {
            "description": "Rate limited: 3 per hour per address and 10 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "tags": [
          "Auth"
        ],
        "summary": "Sign in.",
        "description": "Verifies a password and issues a session. The response is one of exactly two shapes: `{ mfaRequired: false }` with a session cookie, or `{ mfaRequired: true, pendingToken }` with no cookie at all. Every failure — an address with no account, a wrong password, an account with no credential — is the same 401 `INVALID_CREDENTIALS`, and a full Argon2id verification is performed either way so the cases do not differ in cost. Repeated failures lock the account temporarily and notify its owner.",
        "requestBody": {
          "description": "`rememberMe` is optional. Absent means a session that ends with the browser; `true` means the 30-day absolute lifetime and a cookie carrying `Max-Age`. The schema is strict, so an unknown field is a 400 rather than a silently dropped value.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  },
                  "rememberMe": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated, or authenticated so far. `Set-Cookie` carries `__Host-session` and `__Host-csrf` on the first shape and is absent on the second.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "mfaRequired": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      },
                      "required": [
                        "mfaRequired"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "mfaRequired": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "pendingToken": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "mfaRequired",
                        "pendingToken"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "The credentials are not valid (`INVALID_CREDENTIALS`). Identical for an address with no account, a wrong password, and a credential that could not be read."
          },
          "403": {
            "description": "The account cannot be signed in to (`ACCOUNT_LOCKED`) — either a temporary brute-force lock or an administrative one, and the response deliberately does not say which — or the request was refused as cross-site (`CSRF_TOKEN_INVALID`). `ACCOUNT_LOCKED` is returned only when the password was otherwise correct: answering it to any attempt would confirm the address is registered."
          },
          "429": {
            "description": "Rate limited: 5 per 15 minutes per account and 20 per 15 minutes per IP."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "tags": [
          "Auth"
        ],
        "summary": "Sign out.",
        "description": "Revokes the session the request was made with and clears both cookies. The session row is retained with `revokedAt` set rather than deleted: it is the forensic record that the session existed, and the security settings screen reads it. Revocation is immediate — the cache entry is tombstoned before the row is written. Requires `X-CSRF-Token`.",
        "requestBody": {
          "description": "Empty. The schema is strict, so a body with anything in it is a 400.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed out. Both cookies are cleared."
          },
          "401": {
            "description": "No usable session (`UNAUTHENTICATED` or `SESSION_EXPIRED`)."
          },
          "403": {
            "description": "Missing or mismatched `X-CSRF-Token` (`CSRF_TOKEN_INVALID`)."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "authenticated"
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "tags": [
          "Auth"
        ],
        "summary": "Register an account.",
        "description": "Creates an account and sends a verification link. The response is identical whether or not the address is already registered: an address that already has an account receives a notice about the attempt instead of a link, and nothing about the account changes.",
        "requestBody": {
          "description": "The address is lower-cased and trimmed before use. Unknown fields are rejected, not ignored: the schema is strict, so a typo in a field name is a 400 rather than a silently dropped value.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. A message has been sent to the address, whatever it was.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "VERIFICATION_REQUIRED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "The password appears in a public breach corpus (`PASSWORD_BREACHED`). This check is disabled by default and fails open, so its absence is not a claim about the password."
          },
          "429": {
            "description": "Rate limited: 3 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "operationId": "AuthController_resendVerification",
        "tags": [
          "Auth"
        ],
        "summary": "Send the verification link again.",
        "description": "Issues a fresh verification link, which invalidates any previous one for that account. The response is identical for an address with no account, an address awaiting confirmation, and an address already confirmed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  }
                },
                "required": [
                  "email"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. Whether anything was sent is deliberately not reported.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "VERIFICATION_REQUIRED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited: 3 per hour per address and 10 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "operationId": "AuthController_resetPassword",
        "tags": [
          "Auth"
        ],
        "summary": "Choose a new password from a reset link.",
        "description": "Redeems a single-use reset token, replaces the password, and signs every session out — including any the caller is holding. No session is issued: sign in afterwards with the new password. Unknown, expired, already-used and superseded tokens, and a link for an account that is not active, all produce the same refusal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  }
                },
                "required": [
                  "token",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The password is replaced and every session is revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "PASSWORD_RESET"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The request was refused as cross-site (`CSRF_TOKEN_INVALID`)."
          },
          "422": {
            "description": "The link is not redeemable (`TOKEN_INVALID`) — one code and one message for unknown, expired, already-used, superseded and not-active alike; or the password appears in a public breach corpus (`PASSWORD_BREACHED`), which is checked before the link is spent so a refusal does not cost the link."
          },
          "429": {
            "description": "Rate limited: 20 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "AuthController_session",
        "tags": [
          "Auth"
        ],
        "summary": "Describe the current session.",
        "description": "The document the permission-aware frontend reads and nothing else. `permissions` is currently always empty: role assignment does not exist yet, so the effective permission set genuinely is empty rather than unavailable. `entitlements` is an open object and is currently always empty — billing arrives in a later phase. `activeOrganization` is null until an organisation has been chosen. The session identifier is deliberately absent.",
        "responses": {
          "200": {
            "description": "The session document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "activeOrganization": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "slug",
                        "name"
                      ],
                      "additionalProperties": false,
                      "nullable": true
                    },
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "organization.read",
                          "organization.update",
                          "organization.delete",
                          "organization.manage_members",
                          "organization.manage_roles",
                          "project.read",
                          "project.create",
                          "project.update",
                          "project.delete",
                          "asset.read",
                          "asset.create",
                          "asset.update",
                          "asset.delete",
                          "asset.verify_ownership",
                          "scope.read",
                          "scope.update",
                          "scan.read",
                          "scan.create",
                          "scan.cancel",
                          "scan.create_aggressive",
                          "finding.read",
                          "finding.create",
                          "finding.update",
                          "finding.triage",
                          "finding.accept_risk",
                          "finding.delete",
                          "evidence.read",
                          "evidence.upload",
                          "evidence.delete",
                          "engagement.read",
                          "engagement.create",
                          "engagement.update",
                          "engagement.delete",
                          "report.read",
                          "report.create",
                          "report.download",
                          "apikey.read",
                          "apikey.create",
                          "apikey.revoke",
                          "webhook.read",
                          "webhook.create",
                          "webhook.update",
                          "webhook.delete",
                          "integration.read",
                          "integration.manage",
                          "notification.manage",
                          "audit.read",
                          "billing.read",
                          "billing.manage"
                        ]
                      }
                    },
                    "entitlements": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "userId",
                    "activeOrganization",
                    "permissions",
                    "entitlements"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "No usable session, or MFA has not been completed."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "authenticated"
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "operationId": "AuthController_verifyEmail",
        "tags": [
          "Auth"
        ],
        "summary": "Confirm an email address.",
        "description": "Redeems a single-use verification token and marks the address confirmed. Unknown, expired, already-used and superseded tokens all produce the same refusal, so the endpoint cannot be used to discover which addresses are registered.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The address is confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "EMAIL_VERIFIED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "The link is not redeemable (`TOKEN_INVALID`). One code and one message for unknown, expired, already-used and superseded alike."
          },
          "429": {
            "description": "Rate limited: 30 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "OpenApiController_read",
        "tags": [
          "OpenApi"
        ],
        "summary": "The OpenAPI description of this API.",
        "responses": {
          "200": {
            "description": "The OpenAPI 3.0 document."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/health/detailed": {
      "get": {
        "operationId": "HealthController_detailed",
        "tags": [
          "Health"
        ],
        "summary": "Operator detail.",
        "description": "Readiness plus a per-dependency probe latency.",
        "responses": {
          "200": {
            "description": "Readiness with timings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checkedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "dependencies": {
                      "type": "object",
                      "properties": {
                        "postgres": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ]
                            },
                            "latencyMs": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "status",
                            "latencyMs"
                          ],
                          "additionalProperties": false
                        },
                        "redis": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ]
                            },
                            "latencyMs": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "status",
                            "latencyMs"
                          ],
                          "additionalProperties": false
                        },
                        "storage": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ]
                            },
                            "latencyMs": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "status",
                            "latencyMs"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "postgres",
                        "redis",
                        "storage"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "checkedAt",
                    "dependencies"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe.",
        "description": "Reports that the process is running. Touches no dependency.",
        "responses": {
          "200": {
            "description": "The process is alive.",
