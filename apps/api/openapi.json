{
  "openapi": "3.0.3",
  "info": {
    "title": "Sentinel API",
    "version": "1",
    "description": "Multi-tenant security testing, penetration-test management, and vulnerability management."
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "tags": [
          "Auth"
        ],
        "summary": "Register an account.",
        "description": "Creates an account and sends a verification link. The response is identical whether or not the address is already registered: an address that already has an account receives a notice about the attempt instead of a link, and nothing about the account changes.",
        "responses": {
          "200": {
            "description": "Accepted. A message has been sent to the address, whatever it was.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "VERIFICATION_REQUIRED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "The password appears in a public breach corpus (`PASSWORD_BREACHED`). This check is disabled by default and fails open, so its absence is not a claim about the password."
          },
          "429": {
            "description": "Rate limited: 3 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "operationId": "AuthController_resendVerification",
        "tags": [
          "Auth"
        ],
        "summary": "Send the verification link again.",
        "description": "Issues a fresh verification link, which invalidates any previous one for that account. The response is identical for an address with no account, an address awaiting confirmation, and an address already confirmed.",
        "responses": {
          "200": {
            "description": "Accepted. Whether anything was sent is deliberately not reported.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "VERIFICATION_REQUIRED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limited: 3 per hour per address and 10 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "operationId": "AuthController_verifyEmail",
        "tags": [
          "Auth"
        ],
        "summary": "Confirm an email address.",
        "description": "Redeems a single-use verification token and marks the address confirmed. Unknown, expired, already-used and superseded tokens all produce the same refusal, so the endpoint cannot be used to discover which addresses are registered.",
        "responses": {
          "200": {
            "description": "The address is confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "EMAIL_VERIFIED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "The link is not redeemable (`TOKEN_INVALID`). One code and one message for unknown, expired, already-used and superseded alike."
          },
          "429": {
            "description": "Rate limited: 30 per hour per IP address."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "OpenApiController_read",
        "tags": [
          "OpenApi"
        ],
        "summary": "The OpenAPI description of this API.",
        "responses": {
          "200": {
            "description": "The OpenAPI 3.0 document."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/health/detailed": {
      "get": {
        "operationId": "HealthController_detailed",
        "tags": [
          "Health"
        ],
        "summary": "Operator detail.",
        "description": "Readiness plus a per-dependency probe latency.",
        "responses": {
          "200": {
            "description": "Readiness with timings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checkedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "dependencies": {
                      "type": "object",
                      "properties": {
                        "postgres": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ]
                            },
                            "latencyMs": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "status",
                            "latencyMs"
                          ],
                          "additionalProperties": false
                        },
                        "redis": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ]
                            },
                            "latencyMs": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "status",
                            "latencyMs"
                          ],
                          "additionalProperties": false
                        },
                        "storage": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ]
                            },
                            "latencyMs": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "status",
                            "latencyMs"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "postgres",
                        "redis",
                        "storage"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "checkedAt",
                    "dependencies"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe.",
        "description": "Reports that the process is running. Touches no dependency.",
        "responses": {
          "200": {
            "description": "The process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe.",
        "description": "Reports whether every backing dependency is reachable.",
        "responses": {
          "200": {
            "description": "Every dependency is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "dependencies": {
                      "type": "object",
                      "properties": {
                        "postgres": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        },
                        "storage": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "error"
                          ]
                        }
                      },
                      "required": [
                        "postgres",
                        "redis",
                        "storage"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "dependencies"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is unavailable. The envelope names which, and nothing else."
          },
          "default": {
            "description": "Error. Every error response uses the shared envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-sentinel-access": {
          "kind": "public"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHENTICATED",
                  "INVALID_CREDENTIALS",
                  "SESSION_EXPIRED",
                  "MFA_REQUIRED",
                  "MFA_INVALID",
                  "EMAIL_NOT_VERIFIED",
                  "ACCOUNT_LOCKED",
                  "INVALID_API_KEY",
                  "API_KEY_EXPIRED",
                  "CSRF_TOKEN_INVALID",
                  "PERMISSION_DENIED",
                  "NOT_A_MEMBER",
                  "ORGANIZATION_SUSPENDED",
                  "RESOURCE_NOT_FOUND",
                  "VALIDATION_ERROR",
                  "UNKNOWN_FIELD",
                  "INVALID_STATE_TRANSITION",
                  "VERSION_CONFLICT",
                  "DUPLICATE_RESOURCE",
                  "PASSWORD_BREACHED",
                  "TOKEN_INVALID",
                  "SCOPE_VIOLATION",
                  "ASSET_NOT_VERIFIED",
                  "ASSET_VERIFICATION_EXPIRED",
                  "TARGET_DENIED_BY_POLICY",
                  "PROFILE_NOT_PERMITTED",
                  "ENGINE_NOT_AVAILABLE",
                  "SCAN_ALREADY_RUNNING",
                  "SCAN_NOT_CANCELLABLE",
                  "QUOTA_EXCEEDED",
                  "PLAN_LIMIT_REACHED",
                  "FEATURE_NOT_AVAILABLE",
                  "PAYMENT_REQUIRED",
                  "SUBSCRIPTION_INACTIVE",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE",
                  "DEPENDENCY_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {}
              },
              "requestId": {
                "type": "string"
              },
              "documentation": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
