{
  "name": "@sentinel/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -v NODE_ENV=development -- node scripts/next-on-web-port.ts dev",
    "build": "dotenv -e ../../.env -v NODE_ENV=production -- next build",
    "start": "dotenv -e ../../.env -v NODE_ENV=production -- node scripts/next-on-web-port.ts start",
    "start:e2e": "dotenv -e ../../.env -v NODE_ENV=production -v APP_ENV=test -- node scripts/next-on-web-port.ts start --e2e-port",
    "test:e2e": "dotenv -e ../../.env -- playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@sentinel/config": "workspace:*",
    "@sentinel/contracts": "workspace:*",
    "@sentinel/observability": "workspace:*",
    "@sentinel/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "next": "^16.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^7.4.0",
    "ioredis": "^5.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
